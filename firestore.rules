rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Admin check helper function (tlfghlbtghlby@gmail.com)
    function isAdmin() {
      return request.auth != null && 
        (request.auth.token.email == 'tlfghlbtghlby@gmail.com' || 
         request.auth.token.email.lower() == 'tlfghlbtghlby@gmail.com');
    }

    // Authenticated check
    function isAuthenticated() {
      return request.auth != null;
    }

    // User Profile collection:
    match /users/{userId} {
      // Allow read/write for user accounts and admin
      allow read, write: if true;

      // User's private store collection (products, invoices, customers, settings)
      match /store/{docId} {
        allow read, write: if true;
      }
    }

    // Direct stores collection for cross-device sync
    match /stores/{storeId} {
      allow read, write: if true;
      match /{allChildren=**} {
        allow read, write: if true;
      }
    }

    // Default: Allow read and write for app data synchronization across devices
    match /{document=**} {
      allow read, write: if true;
    }
  }
}

